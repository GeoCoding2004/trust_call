# Trust-Call Environment Variables
#
# Copy this file to .env and fill in any values needed for your environment.
# Never commit .env with real secrets.
#
# ----------------------------------------------------------------
# Backend Gateway (trust_call_backend)
# ----------------------------------------------------------------

# Port the backend FastAPI gateway listens on
BACKEND_PORT=8080

# URL where the RawNet IEP1 service can be reached from the backend
RAWNET_URL=http://127.0.0.1:8000/predict

# URL where the DistilBERT IEP2 service can be reached from the backend
DISTILBERT_URL=http://127.0.0.1:8002/predict

# STUN server for WebRTC ICE (default: Google public STUN)
TRUST_CALL_WEBRTC_STUN_URL=stun:stun.l.google.com:19302

# Demo default is "*". For production, restrict this to trusted origins only.
CORS_ORIGINS=*

# Whisper model name (tiny.en is fast and CPU-friendly)
WHISPER_MODEL_NAME=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio quality thresholds (tune for your microphone / environment)
TRUST_CALL_SIGNAL_MIN_RMS=0.0025
TRUST_CALL_SIGNAL_MIN_PEAK=0.02
TRUST_CALL_SIGNAL_MIN_ACTIVE_RATIO=0.015

# Semantic context window (seconds of speech before sending to DistilBERT)
TRUST_CALL_SEMANTIC_CONTEXT_SECONDS=8.0
TRUST_CALL_SEMANTIC_MAX_CONTEXT_SECONDS=12.0

# ----------------------------------------------------------------
# Auth (optional - for future production hardening)
# ----------------------------------------------------------------

# Set to false to require X-API-Key header on all requests.
# true = demo mode (no auth check). Default: true.
ENABLE_DEMO_MODE=true

# API key for production mode (not enforced while ENABLE_DEMO_MODE=true)
API_KEY=replace_me_for_production

# ----------------------------------------------------------------
# RawNet Service (rawnet-service)
# ----------------------------------------------------------------

RAWNET_PORT=8000

# RawNet weights are not committed to Git. Mount or provide this file at runtime for real inference.
RAWNET_MODEL_PATH=/models/fine_tuned_DF_model.pth

# ----------------------------------------------------------------
# DistilBERT / Semantic Service (distilbert-service)
# ----------------------------------------------------------------

DISTILBERT_PORT=8002

# HuggingFace model name or local path for the scam classifier
DISTILBERT_MODEL_NAME=./custom_scam_model

# Set to true to use the fine-tuned neural classifier; false uses heuristic fallback
DISTILBERT_USE_CLASSIFIER=true

# Set to true to enable embedding-layer adjustment in heuristic mode
DISTILBERT_USE_EMBEDDINGS=true

# Set to true to use CUDA GPU for DistilBERT inference (requires CUDA container)
DISTILBERT_USE_CUDA=false

# ----------------------------------------------------------------
# Monitoring
# ----------------------------------------------------------------

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------

LOG_LEVEL=INFO

# ----------------------------------------------------------------
# Cloud deployment (GCP VM)
# ----------------------------------------------------------------

# Public IP of the GCP Compute Engine VM (for reference only)
GCP_VM_PUBLIC_IP=35.189.221.158
